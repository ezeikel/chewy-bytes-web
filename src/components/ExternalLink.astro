---
/**
 * An outbound link with a small arrow that nudges on hover.
 *
 * `emphasis` picks the two roles used on this page: "strong" for the primary
 * action in a card (the App Store), "quiet" for supporting links.
 */
type Props = {
  href: string;
  emphasis?: 'strong' | 'quiet';
  class?: string;
};

const { href, emphasis = 'quiet', class: className = '' } = Astro.props;

const tone =
  emphasis === 'strong'
    ? 'text-ink font-medium decoration-line'
    : 'text-muted decoration-line/80';
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`group/link inline-flex items-center gap-1 underline underline-offset-4 transition-colors hover:text-brand hover:decoration-brand ${tone} ${className}`}
>
  <slot />
  <svg
    aria-hidden="true"
    viewBox="0 0 12 12"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-3 shrink-0 transition-transform duration-200 group-hover/link:-translate-y-px group-hover/link:translate-x-px"
  >
    <path d="M3.25 8.75 8.75 3.25" />
    <path d="M4.5 3.25h4.25V7.5" />
  </svg>
</a>
